{
  "env": {
    "TMPDIR": "/private/tmp"
  },
  "permissions": {
    "allow": [],
    "additionalDirectories": []
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/runcat-metrics.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/runcat-metrics.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/git-signing-preflight.sh",
            "timeout": 20,
            "statusMessage": "コミット署名を事前確認中"
          },
          {
            "type": "command",
            "command": "~/.claude/git-safety-guard.sh",
            "timeout": 10,
            "statusMessage": "git 操作の安全確認中"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "metaphor-sketch@shinyaoguri": true,
    "metaphor-contrib@shinyaoguri": true,
    "repo-standards@shinyaoguri": true
  },
  "extraKnownMarketplaces": {
    "cosense-cli": {
      "source": {
        "source": "github",
        "repo": "helpfeel/cosense-cli"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "shinyaoguri": {
      "source": {
        "source": "github",
        "repo": "shinyaoguri/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/runcat-metrics.py"
  },
  "language": "japanese",
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true
}
