{
  "env": {
    "TMPDIR": "/private/tmp"
  },
  "attribution": {
    "commit": "Assisted-by: Claude <noreply@anthropic.com>",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(jq:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree list:*)",
      "Bash(git fetch:*)",
      "Bash(git gone)",
      "Bash(git stale)",
      "Bash(gh auth status)",
      "Bash(gh repo view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(op read:*)"
    ],
    "additionalDirectories": [
      "~/Repos",
      "~/.setup",
      "~/.claude"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/runcat-metrics.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/runcat-metrics.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "git rev-parse --git-dir >/dev/null 2>&1 && git gone-clean >/dev/null 2>&1 || true",
            "timeout": 30,
            "statusMessage": "役目を終えたブランチを掃除中"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/git-signing-preflight.sh",
            "timeout": 20,
            "statusMessage": "コミット署名を事前確認中"
          },
          {
            "type": "command",
            "command": "~/.claude/git-safety-guard.sh",
            "timeout": 10,
            "statusMessage": "git 操作の安全確認中"
          },
          {
            "type": "command",
            "command": "~/.claude/provisioning-preflight.sh",
            "timeout": 30,
            "statusMessage": "プロビジョニングの変更内容を事前確認中"
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/worktree-path-guard.sh",
            "timeout": 10,
            "statusMessage": "編集先の worktree を確認中"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/runcat-metrics.py"
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "metaphor-sketch@shinyaoguri": true,
    "metaphor-contrib@shinyaoguri": true,
    "repo-standards@shinyaoguri": true
  },
  "extraKnownMarketplaces": {
    "cosense-cli": {
      "source": {
        "source": "github",
        "repo": "helpfeel/cosense-cli"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "shinyaoguri": {
      "source": {
        "source": "github",
        "repo": "shinyaoguri/claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "language": "japanese",
  "tui": "fullscreen",
  "theme": "auto",
  "agentPushNotifEnabled": true
}
