#!/usr/bin/env bash
# 秘密を 1Password から読む。ただし低権限で単一用途のものだけは macOS Keychain へ
# キャッシュし、1Password がロックされていても読めるようにする。
#
# なぜ要るか: 無人で走る自動化 (Claude の hook・scheduled task・バックグラウンドの
# セッション) が、生体認証を前提にした資格情報に依存していて、ロック中は黙って止まる。
# かといって 1Password の自動ロックを切ると、誰も見ていない時間に全 vault が読める状態に
# なってしまう (SSH キーアイテムの秘密鍵も CLI から取り出せる)。そこで秘密を等級で分け、
# 常時開放するのは「キャッシュを許した役割」だけに絞る。
#
# キャッシュは**役割** (gyazo-token など) を通したときだけ行う。どの役割を許すかは
# secret-cache-allowlist に書いてある (載せてよい条件もそこに書いた)。その役割にどの項目を
# 充てるかは、使う人の 1Password でタグ `secret-read/<役割>` を付けて決める。保管庫や項目の
# 名前は人ごとに違うので、公開リポジトリに `op://` の参照を書かずに済ませるための分担
# (issue #289)。`op://` の参照を直接渡したときは素通しで op read するだけで、Keychain には
# 一切残さない。この線引きは文書ルールではなくこのスクリプトが強制する。
#
# キャッシュには寿命がある。正本はあくまで 1Password 側なので、TTL を過ぎた項目は次に
# 読まれたときに取り直す。取り直せなければ (ロック中・op が無い) 古い値のまま動き続ける
# ので、可用性は落ちない。これが無いと、ローテートしたトークンをいつまでも返し続け、
# 症状は「その API だけが unauthorized で落ちる」という原因から最も遠い形で出る。
#
# 使い方:
#   secret-read <役割>             値を stdout へ (Keychain にキャッシュする)
#   secret-read <op-reference>     値を stdout へ (op read の置き換え。キャッシュしない)
#   secret-read --refresh <役割>   op から取り直して上書きする (ローテート直後に急ぐとき)
#   secret-read --forget <役割>    Keychain のキャッシュを消す (旧来の op:// のキャッシュも消せる)
#   secret-read --check            依存と許可リストの健全性だけ見る (値は出さない)
#   secret-read --warm             許可リストの未キャッシュをいま取得して入れる (新しいマシンで)
#
# 契約: 値は stdout にしか出さない。エラー文にも値を出さない。
# 呼び出し口は gyazo-capture スキル等の `$(secret-read "$REF")` (REF は役割名)。
# 役割の解決に jq を使う (macOS 15 以降は /usr/bin/jq を同梱している)。
# テストは claude/tests/secret_read_test.py (op / security を PATH で偽物に差し替える)。
# 差し替え口: SECRET_CACHE_TTL (取り直しの間隔・秒。0 で自動更新を止める)
#             SECRET_CACHE_REFRESH_TIMEOUT (取り直しを諦めるまでの秒数)
#             SECRET_CACHE_RETRY (取り直しに失敗した後、次に試すまでの秒数。既定 1 時間)
# 許可リストの場所に差し替え口は無い (常にこのスクリプトの実体の隣を読む。issue #214)

set -euo pipefail

# symlink 経由で呼ばれても許可リストを見失わないように実体まで辿る
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  link_dir=$(cd -P "$(dirname "$source_path")" && pwd)
  source_path=$(readlink "$source_path")
  case "$source_path" in /*) ;; *) source_path="$link_dir/$source_path" ;; esac
done
readonly source_path

SCRIPT_DIR=$(cd -P "$(dirname "$source_path")" && pwd)
readonly SCRIPT_DIR

# **許可リストの場所は差し替えられない。** 以前は SECRET_CACHE_ALLOWLIST でパスを渡せた
# (テスト用の口)。それは等級の線引きそのものを環境変数 1 つで外せるということで、
# 1Password が解錠されている間に緩いリストを指して高い等級の参照を読めば、その秘密が
# Keychain に残り続ける — 「承認プロンプトが出ること自体が防御」の秘密が、以後は無確認で
# 読める (issue #214)。読むのは常に、このスクリプトの実体の隣にあるリスト。テストは
# 同じ配置を一時ディレクトリに作り、スクリプトの写しを流す。
ALLOWLIST="$SCRIPT_DIR/../secret-cache-allowlist"
readonly ALLOWLIST

# Keychain の account。同じ Mac を複数ユーザーで使う場合に混ざらないようにする
KEYCHAIN_ACCOUNT="${USER:-$(id -un)}"
readonly KEYCHAIN_ACCOUNT

die() {
  printf 'secret-read: %s\n' "$1" >&2
  exit 1
}

# 環境変数の数値。壊れていても止めない — このスクリプトが止まると無人セッションが
# 止まるので、警告して既定へ倒す方が目的に合う
numeric_env() {
  local name="$1" fallback="$2" value
  eval "value=\${$name:-}"
  [ -n "$value" ] || {
    printf '%s' "$fallback"
    return 0
  }
  case "$value" in
  '' | *[!0-9]*)
    printf 'secret-read: %s は 0 以上の整数で指定する (既定 %s を使う): %s\n' \
      "$name" "$fallback" "$value" >&2
    printf '%s' "$fallback"
    ;;
  *) printf '%s' "$value" ;;
  esac
}

# キャッシュの寿命。既定 24 時間 = ローテートに一日で追いつく。0 で自動更新を止める
CACHE_TTL=$(numeric_env SECRET_CACHE_TTL 86400)
readonly CACHE_TTL

# 期限切れの取り直しを諦めるまで。1Password がロックされていると op read は承認を待って
# 返らないので、上限が要る (待たせたらキャッシュを持つ意味が無い)。
# 0 は許さない — 上限を外す設定を用意すると、それを踏んだ無人セッションが止まる
REFRESH_TIMEOUT=$(numeric_env SECRET_CACHE_REFRESH_TIMEOUT 10)
[ "$REFRESH_TIMEOUT" -ge 1 ] || REFRESH_TIMEOUT=1
readonly REFRESH_TIMEOUT

# 取り直しに失敗した後、次に試すまでの間隔。既定 1 時間。
#
# 失敗のたびに次の試行を TTL いっぱい (24 時間) 先送りしていたことがある。期限切れ後の
# 最初の読み出しが毎回ロック中に当たる構成 (夜間の scheduled task) では失敗が毎日
# 繰り返され、いつまでもローテートに追いつかなかった (issue #213)。間隔を空けること
# 自体は要る — 無いと、ロック中は呼び出しのたびに REFRESH_TIMEOUT を待つことになる。
RETRY_INTERVAL=$(numeric_env SECRET_CACHE_RETRY 3600)
readonly RETRY_INTERVAL

now_epoch() {
  date +%s
}

usage() {
  cat <<'EOF'
secret-read — 1Password の秘密を読む (低権限のものだけ Keychain にキャッシュする)

  secret-read <役割>             値を stdout へ (Keychain にキャッシュする)
  secret-read <op-reference>     値を stdout へ (op read の置き換え。キャッシュしない)
  secret-read --refresh <役割>   op から取り直して上書きする (ローテート直後に急ぐとき)
  secret-read --forget <役割>    Keychain のキャッシュを消す (旧来の op:// のキャッシュも消せる)
  secret-read --check            依存と許可リストの健全性だけ見る (値は出さない)
  secret-read --warm             許可リストの未キャッシュをいま取得して入れる (値は出さない)

キャッシュしてよい役割は secret-cache-allowlist に列挙する。役割に充てる項目は、
1Password でその項目にタグ secret-read/<役割> を付けて決める (ちょうど 1 件に付ける)。
値は項目の credential フィールドから、無ければただ 1 つの添付ファイルから読む。
op:// の参照を直接渡したときは Keychain に残さず、そのつど 1Password から読む。

キャッシュは既定で 24 時間ごとに 1Password から取り直す (SECRET_CACHE_TTL で変えられる。
0 で自動更新を止める)。タグを別の項目へ付け替えたときも、取り直しで追いつく。
取り直せないときは古い値のまま動き続けるので、1Password がロックされていても
止まらない。失敗した後は 1 時間おきにもう一度試す (SECRET_CACHE_RETRY)。
失敗したままの役割は --check に出る。
EOF
}

# 役割名。タグ (secret-read/<役割>) と Keychain の名前にそのまま入るので、字種を絞る。
# a-z の範囲指定を使わないのは、macOS 同梱の bash 3.2 ではロケールによって大文字も入るため
is_role_name() {
  case "$1" in
  '' | -* | *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;;
  esac
  return 0
}

# 引数が op:// の参照なら ref、役割名なら role を返す。どちらでもなければ止める
classify_target() {
  case "$1" in
  op://*) printf 'ref' ;;
  *)
    is_role_name "$1" ||
      die "役割名 (英小文字・数字・-) か op:// で始まる参照を渡す: $1"
    printf 'role'
    ;;
  esac
}

# 役割の値を預ける Keychain の名前。旧来の op:// の名前と混ざらない
role_service() { printf 'secret-read/%s' "$1"; }

# 役割に充てた項目の名前 (値ではない) の控え。--check が op を呼ばずに見せるためのもの
item_service() { printf '%s#item' "$(role_service "$1")"; }

# 前後の空白を落とす
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# 役割が許可リストに完全一致で載っているか。行頭 # はコメント、空行は無視
is_cacheable() {
  local role="$1" line
  [ -r "$ALLOWLIST" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in \#*) continue ;; esac
    line=$(trim "$line")
    [ -n "$line" ] || continue
    [ "$line" = "$role" ] && return 0
  done <"$ALLOWLIST"
  return 1
}

# 値は base64 にして預ける。改行や特殊文字を含む秘密でも往復が壊れず、security(1) の
# 引数に値が乗らない (プロンプトへ流し込む形になる) ので ps からも見えない。
#
# 預ける文字列は "<最終取得時刻>:<base64値>"。時刻を一緒に持つことで、寿命の判定に
# Keychain の項目以外を読まずに済む。base64 のアルファベット (A-Za-z0-9+/=) に ':' は
# 現れないので、区切りの有無だけで旧形式と見分けられる — 移行の手続きが要らず、
# 時刻を持たない古い項目は「時刻不明」= 次に読まれたときに取り直される。
#
# ただし security(1) は **stdin から読むパスワードを 128 文字で黙って切る** (実測)。
# 収まらない値は分割して預ける: 本体の項目には "<時刻>:@<個数>" を置き、実体は
# "<参照>#1" .. "<参照>#<個数>" に分けて入れる。'@' は base64 に現れないので、
# 分割済みかどうかは先頭 1 文字で見分けられる (':' と同じ手)。
#
# 値を引数で渡せば上限は無いが、その形は ps から見えてしまう。見えないことを保つほうを
# 優先して、分割する側を選んだ。
CACHED_VALUE=""
CACHED_EPOCH=""

KEYCHAIN_MAX=128    # security(1) が stdin から受け取れる文字数 (実測した上限)
KEYCHAIN_CHUNK=120  # 分割の単位。上限との差は接頭辞や将来の余裕に充てる

# 保存文字列から時刻の部分だけを取り出す。数字でなければ 0 (= 期限切れ扱い) に倒す
epoch_of() {
  local raw="$1" epoch
  case "$raw" in
  *:*) epoch="${raw%%:*}" ;;
  *) epoch=0 ;;
  esac
  case "$epoch" in
  '' | *[!0-9]*) epoch=0 ;;
  esac
  printf '%s' "$epoch"
}

# 成功したら CACHED_VALUE / CACHED_EPOCH に入れる (値を stdout へ出さないのは、
# --check のように「あるかどうか」だけ知りたい呼び出しと同じ経路を使うため)
keychain_get() {
  local raw encoded
  raw=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$1" -w 2>/dev/null) || return 1
  [ -n "$raw" ] || return 1
  case "$raw" in
  *:*) encoded="${raw#*:}" ;;
  *) encoded="$raw" ;;
  esac
  [ -n "$encoded" ] || return 1
  case "$encoded" in
  @*) encoded=$(keychain_join "$1" "${encoded#@}") || return 1 ;;
  esac
  CACHED_VALUE=$(printf '%s' "$encoded" | base64 -d 2>/dev/null) || return 1
  CACHED_EPOCH=$(epoch_of "$raw")
  return 0
}

# --check 用。値には一切触れず、最終取得時刻だけを見る
keychain_epoch() {
  local raw
  raw=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$1" -w 2>/dev/null) || return 1
  [ -n "$raw" ] || return 1
  epoch_of "$raw"
}

# 第 3 引数で時刻を指定できる。値は変えずに時刻だけ進めたいとき (取り直しに失敗した
# ときの再試行抑制) に使う
# 分割して預けた実体を連結して返す。1 つでも欠けていれば失敗として扱う
# (半端に繋いだ値を秘密として返すほうが危ない)
keychain_join() { # $1=参照 $2=個数
  local ref="$1" count="$2" i=1 piece all=""
  case "$count" in '' | *[!0-9]*) return 1 ;; esac
  while [ "$i" -le "$count" ]; do
    piece=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$ref#$i" -w 2>/dev/null) || return 1
    [ -n "$piece" ] || return 1
    all="$all$piece"
    i=$((i + 1))
  done
  printf '%s' "$all"
}

# 制御端末を切り離してコマンドを流す。
#
# security(1) はパスワードを getpass() で読み、getpass は **/dev/tty を先に開く**
# (開けないときだけ stdin へ落ちる)。制御端末があるとパイプの値は読まれず、端末に
# `password data for new item:` を出したまま待ち続ける — 出力は捨てているので、何も
# 見えずに止まって見える。そこへ人が何か打つと、**その文字列がキャッシュに入る**。
# Claude の Bash ツールや hook は制御端末を持たないので動いていたが、README が案内する
# `secret-read --warm` と setup の Step 7 は人が端末から打つ経路で、そこでだけ止まって
# いた (実測。issue #212)。
#
# 新しいセッションへ移せば (setsid) 制御端末が外れ、getpass は stdin へ落ちる。
# プロセスグループのリーダーは setsid できないので、fork してから呼ぶ。終了コードは
# そのまま返し、シグナルで死んだ場合を成功 (0) に化けさせない。
#
# `security -i` へコマンド行で渡す手もあるが、1 行が 4096 文字で切れるうえ値の引用を
# こちらで組むことになる。perl は macOS が同梱している。無い環境では素のまま流す
# (制御端末の無いところでは元から動く)。
without_tty() {
  if command -v perl >/dev/null 2>&1; then
    # shellcheck disable=SC2016  # perl のコード。シェルに展開させない
    perl -MPOSIX -e '
      my $pid = fork;
      die "fork: $!" unless defined $pid;
      if ($pid) {
        waitpid $pid, 0;
        exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);
      }
      POSIX::setsid();
      exec @ARGV;
      exit 127;
    ' -- "$@"
  else
    "$@"
  fi
}

keychain_write() { # $1=service $2=預ける文字列
  # security(1) は確認のため 2 回読む。-U は既存項目の上書き
  printf '%s\n%s\n' "$2" "$2" |
    without_tty security add-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$1" -U \
      -l "secret-read: $1" \
      -j "secret-read が 1Password からキャッシュした値。正本は 1Password 側。" \
      -w >/dev/null 2>&1
}

# **書き切ってから余分を消す。** 先に消すと、書き込みが失敗したときに古い値ごと
# 失われる — この仕組みの本命 (1Password が閉じていても呼び出し側が止まらない) が
# Keychain の一時的な不調で崩れる (issue #168)。keychain_write は -U (上書き) なので、
# 同じ場所へ書く分には先に消す必要が無い。掃除が要るのは「前回より分割数が減ったとき
# に残る古い実体」だけなので、書き終えてからその範囲だけを消す。
keychain_put() {
  local ref="$1" value="$2" epoch="${3:-}" encoded entry rest count=0 i
  [ -n "$epoch" ] || epoch=$(now_epoch)
  # base64 は環境によって折り返すので 1 行に均す (折り返しが入ると分割の計算が狂う)
  encoded=$(printf '%s' "$value" | base64 | tr -d '\n')

  entry="$epoch:$encoded"
  if [ "${#entry}" -le "$KEYCHAIN_MAX" ]; then
    keychain_write "$ref" "$entry" || return 1
    # 前回が分割だったなら、その実体はもう要らない
    keychain_forget_chunks "$ref" 1
    return 0
  fi

  rest="$encoded"
  while [ -n "$rest" ]; do
    count=$((count + 1))
    # 途中の失敗を握り潰さない。欠番のまま本体だけ書くと、読み出しが
    # 「キャッシュ無し」に落ちて op が必須になる
    keychain_write "$ref#$count" "${rest:0:$KEYCHAIN_CHUNK}" || return 1
    rest="${rest:$KEYCHAIN_CHUNK}"
  done
  keychain_write "$ref" "$epoch:@$count" || return 1
  keychain_forget_chunks "$ref" $((count + 1))
  return 0
}

# $2 番目以降の分割実体を消す。欠番は作らないので、無くなった時点で終わり。
keychain_forget_chunks() {
  local ref="$1" i="$2"
  while security delete-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$ref#$i" >/dev/null 2>&1; do
    i=$((i + 1))
  done
}

# 取り直しに失敗した時刻の控え。**キャッシュ本体とは別の項目に置く** — 本体の時刻は
# 「最後に 1Password から取れた時刻」のまま動かさない。混ぜると --check が失敗しただけの
# 時刻を「取得した時刻」として見せ、ローテートに追いついていないことが読めなくなる。
# 本体を書き直さないので、分割して預けた長い値 (PEM) でも security の起動は 1 回で済む。
# 名前は分割の実体 ("<参照>#<番号>") と同じ名前空間で、番号にならない語を使う。
attempt_service() { printf '%s#attempt' "$1"; }

failed_attempt_epoch() { # $1=参照 → 失敗した時刻。控えが無ければ失敗
  local raw
  raw=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$(attempt_service "$1")" -w 2>/dev/null) || return 1
  case "$raw" in '' | *[!0-9]*) return 1 ;; esac
  printf '%s' "$raw"
}

note_failed_attempt() { keychain_write "$(attempt_service "$1")" "$(now_epoch)" || true; }

clear_failed_attempt() {
  security delete-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$(attempt_service "$1")" >/dev/null 2>&1 || true
}

# 消えていることが目的なので、もともと無かった場合も成功として扱う
keychain_forget() {
  local ref="$1" i=1
  security delete-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$ref" >/dev/null 2>&1 || true
  clear_failed_attempt "$ref"
  security delete-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$ref#item" >/dev/null 2>&1 || true
  # 分割して預けた実体も消す。欠番は作らないので、無くなった時点で終わり
  while security delete-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$ref#$i" >/dev/null 2>&1; do
    i=$((i + 1))
  done
}

op_read() {
  command -v op >/dev/null 2>&1 ||
    die "op (1Password CLI) が見つからず、キャッシュにも無いので値を取れない: $1"
  op read "$1"
}

# op を時間を区切って呼ぶ。期限切れの取り直し専用。失敗しても呼び出し元は古い値で続行
# するので、待たないことが何より大事: 1Password がロックされていると op は承認ダイアログを
# 出したまま返らない。
#
# macOS には timeout(1) も gtimeout も無いので、番兵のサブシェルを立てて時間切れで op を
# 終わらせる。alarm(2) では駄目だった — op は Go 製で SIGALRM を受けても死なず、実測で
# 2 分以上生き残った。確実に終わらせるには SIGTERM、それでも残るなら SIGKILL が要る。
#
# 番兵の出力を /dev/null へ捨てているのは飾りではない。コマンド置換は stdout を持つ子が
# 全ていなくなるまで返らないので、番兵が stdout を握っていると op を殺しても待たされる。
op_bounded() {
  local out

  out=$(
    op "$@" 2>/dev/null &
    op_pid=$!

    (
      sleep "$REFRESH_TIMEOUT"
      kill -TERM "$op_pid" 2>/dev/null || true
      sleep 1
      kill -KILL "$op_pid" 2>/dev/null || true
    ) >/dev/null 2>&1 &
    sentinel_pid=$!

    if wait "$op_pid"; then
      op_rc=0
    else
      op_rc=$?
    fi
    kill "$sentinel_pid" 2>/dev/null || true
    exit "$op_rc"
  ) || return 1

  [ -n "$out" ] || return 1
  printf '%s' "$out"
}

# $1=bounded (1 なら op_bounded) のあとに op の引数
op_call() {
  local bounded="$1"
  shift
  if [ "$bounded" = 1 ]; then
    op_bounded "$@" </dev/null
  else
    op "$@" </dev/null
  fi
}

# 役割に充てた項目を、1Password のタグ secret-read/<役割> から探す。
# 成功したら "<読み出す op:// の参照><TAB><項目の名前>" を stdout へ出す (どちらも値ではない)。
#
# 参照は保管庫と項目の ID で組む。名前で組むと、名前に / が入った項目や、同じ名前の項目が
# 別の保管庫にある場合に別のものを読みうる。
role_resolve() {
  local role="$1" bounded="$2" tag list count id vault title item field
  tag="secret-read/$role"
  command -v jq >/dev/null 2>&1 || {
    printf 'secret-read: jq が見つからず、役割 %s を解決できない\n' "$role" >&2
    return 1
  }

  list=$(op_call "$bounded" item list --tags "$tag" --format json) || return 1
  count=$(printf '%s' "$list" | jq 'length') || return 1
  case "$count" in
  1) ;;
  0)
    printf 'secret-read: 1Password にタグ %s の付いた項目が無い (役割 %s に充てる項目へ付ける)\n' \
      "$tag" "$role" >&2
    return 1
    ;;
  *)
    printf 'secret-read: タグ %s の付いた項目が %s 件ある。1 件に絞る: %s\n' \
      "$tag" "$count" "$(printf '%s' "$list" | jq -r '[.[].title] | join(", ")')" >&2
    return 1
    ;;
  esac
  id=$(printf '%s' "$list" | jq -r '.[0].id')
  vault=$(printf '%s' "$list" | jq -r '.[0].vault.id')
  title=$(printf '%s' "$list" | jq -r '.[0].title')

  # フィールドの一覧を見るだけで、値はここでは使わない (読み出しは op read に任せる)
  item=$(op_call "$bounded" item get "$id" --vault "$vault" --format json) || return 1
  if printf '%s' "$item" | jq -e 'any(.fields[]?; .id == "credential" or .label == "credential")' >/dev/null; then
    field=credential
  elif [ "$(printf '%s' "$item" | jq '.files // [] | length')" = 1 ]; then
    field=$(printf '%s' "$item" | jq -r '.files[0].name')
  else
    printf 'secret-read: 項目「%s」に credential フィールドも、ただ 1 つの添付ファイルも無い (役割 %s)\n' \
      "$title" "$role" >&2
    return 1
  fi
  item=''

  printf 'op://%s/%s/%s\t%s\n' "$vault" "$id" "$field" "$title"
}

# 役割の値を 1Password から取り、stdout へ出す。充てた項目の名前も控えておく
role_fetch() {
  local role="$1" bounded="$2" resolved ref title value
  resolved=$(role_resolve "$role" "$bounded") || return 1
  ref="${resolved%%$'\t'*}"
  title="${resolved#*$'\t'}"
  value=$(op_call "$bounded" read "$ref") || return 1
  [ -n "$value" ] || return 1
  # 名前は表示のためだけのもの。書けなくても値の取得は成功として扱う
  keychain_write "$(item_service "$role")" "$title" || true
  printf '%s' "$value"
}

# キャッシュが寿命を過ぎていたら 1Password から取り直し、CACHED_VALUE を最新にする。
# 取り直せなければ古い値のまま。呼び出し元から見て「失敗」は無い。
# タグから引き直すので、タグを別の項目へ付け替えた場合もここで追いつく
refresh_if_stale() {
  local role="$1" service fresh age attempted
  service=$(role_service "$role")
  [ "$CACHE_TTL" -gt 0 ] || return 0
  # op が無い環境では取り直しようがない。時刻も触らない (状況が変わったら次に試す)
  command -v op >/dev/null 2>&1 || return 0

  age=$(($(now_epoch) - CACHED_EPOCH))
  [ "$age" -ge "$CACHE_TTL" ] || return 0

  # 直前に失敗しているなら、間隔が空くまで試さない。これが無いと 1Password が閉じて
  # いる間じゅう、呼び出しのたびにタイムアウトを待つことになる
  if attempted=$(failed_attempt_epoch "$service") &&
    [ "$(($(now_epoch) - attempted))" -lt "$RETRY_INTERVAL" ]; then
    return 0
  fi

  if fresh=$(role_fetch "$role" 1) && [ -n "$fresh" ]; then
    CACHED_VALUE="$fresh"
    if keychain_put "$service" "$fresh"; then
      clear_failed_attempt "$service"
    else
      printf 'secret-read: Keychain を更新できなかった (値は取れている): %s\n' "$role" >&2
    fi
    return 0
  fi

  # 取り直せなかった (ロック中・承認待ちでタイムアウト・項目が消えた)。値も最終取得時刻も
  # 据え置きで、失敗した時刻だけを控える。次は RETRY_INTERVAL の後にもう一度試す。
  # 急ぐときのための --refresh がある
  note_failed_attempt "$service"
}

# 取得してキャッシュにも入れる。書き込みに失敗しても値は返す (機能低下で済ませる)
fetch_and_cache() {
  local role="$1" service value
  service=$(role_service "$role")
  command -v op >/dev/null 2>&1 ||
    die "op (1Password CLI) が見つからず、キャッシュにも無いので値を取れない: $role"
  value=$(role_fetch "$role" 0) || die "1Password から役割 $role の値を取れなかった"
  if keychain_put "$service" "$value"; then
    # --refresh で手で取り直せたなら、失敗の控えはもう当たらない
    clear_failed_attempt "$service"
  else
    printf 'secret-read: Keychain へ保存できなかった (値の取得はできている): %s\n' "$role" >&2
  fi
  printf '%s\n' "$value"
}

# 秒数を期間として読める形に (「〜前」ではなく「〜ごと」の側)
humanize_ttl() {
  local secs="$1"
  if [ "$secs" -lt 60 ]; then
    printf '%d 秒' "$secs"
  elif [ "$secs" -lt 3600 ]; then
    printf '%d 分' $((secs / 60))
  elif [ "$secs" -lt 86400 ]; then
    printf '%d 時間' $((secs / 3600))
  else
    printf '%d 日' $((secs / 86400))
  fi
}

# 経過秒を人が読める形に。値は出さないという --check の契約に触れない情報だけを扱う
humanize_age() {
  local secs="$1"
  if [ "$secs" -lt 60 ]; then
    printf '1 分以内'
  elif [ "$secs" -lt 3600 ]; then
    printf '%d 分前' $((secs / 60))
  elif [ "$secs" -lt 86400 ]; then
    printf '%d 時間前' $((secs / 3600))
  else
    printf '%d 日前' $((secs / 86400))
  fi
}

cmd_check() {
  local line count=0 status epoch age attempted service title
  printf '許可リスト: %s\n' "$ALLOWLIST"
  [ -r "$ALLOWLIST" ] || die "許可リストが読めない: $ALLOWLIST"

  if command -v op >/dev/null 2>&1; then
    printf 'op: %s\n' "$(command -v op)"
  else
    printf 'op: 見つからない (キャッシュ済みの役割だけが読める)\n'
  fi
  printf 'jq: %s\n' "$(command -v jq || printf '見つからない (役割を 1Password から解決できない)')"
  printf 'security: %s\n' "$(command -v security || printf '見つからない')"
  printf 'Keychain account: %s\n\n' "$KEYCHAIN_ACCOUNT"

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in \#*) continue ;; esac
    line=$(trim "$line")
    [ -n "$line" ] || continue
    count=$((count + 1))
    if ! is_role_name "$line"; then
      printf '  [不正] %s — 役割名 (英小文字・数字・-) ではない (op:// の参照は書かない)\n' "$line"
      continue
    fi
    service=$(role_service "$line")
    # 値は出さない。キャッシュの有無と鮮度、充てた項目の名前だけを見る
    if epoch=$(keychain_epoch "$service"); then
      if [ "$epoch" -eq 0 ]; then
        status='キャッシュ済み (取得時刻が不明 — 次に読むとき取り直す)'
      else
        age=$(($(now_epoch) - epoch))
        status="キャッシュ済み ($(humanize_age "$age")に取得)"
      fi
      if title=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$(item_service "$line")" -w 2>/dev/null) &&
        [ -n "$title" ]; then
        status="$status — 項目「${title}」"
      fi
      # 取り直しに失敗したままなら、それも見せる。上の時刻が古い理由がここで読める
      if attempted=$(failed_attempt_epoch "$service"); then
        status="$status — 取り直しに失敗 ($(humanize_age $(($(now_epoch) - attempted))))"
      fi
    else
      status="未キャッシュ (1Password の項目にタグ secret-read/$line を付け、secret-read --warm で入る)"
    fi
    printf '  %s — %s\n' "$line" "$status"
  done <"$ALLOWLIST"

  printf '\nキャッシュを許した役割: %d 件\n' "$count"
  if [ "$CACHE_TTL" -gt 0 ]; then
    printf '取り直しの間隔: %sごと (SECRET_CACHE_TTL)\n' "$(humanize_ttl "$CACHE_TTL")"
  else
    printf '取り直し: 無効 (SECRET_CACHE_TTL=0)\n'
  fi
}

# 許可リストの役割のうち未キャッシュのものを、いま 1Password から読んでキャッシュへ入れる。
# 新しいマシンでは初回の読み出しまでキャッシュが空で、それを踏むのが無人セッションだと
# 承認待ちで止まる。人がいるセットアップ中に打って、承認をここで済ませておくためのもの。
# キャッシュ済みの役割には触らない (鮮度は通常の読み出しが TTL で面倒を見る)。
cmd_warm() {
  local line value failed=0
  local roles=()
  [ -r "$ALLOWLIST" ] || die "許可リストが読めない: $ALLOWLIST"
  command -v op >/dev/null 2>&1 || die "op (1Password CLI) が見つからない"

  # 先に読み切る。op は stdin を読みうるので、許可リストを流し込んだまま呼ぶと行を食われる
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in \#*) continue ;; esac
    line=$(trim "$line")
    is_role_name "$line" && roles+=("$line")
  done <"$ALLOWLIST"

  for line in ${roles[@]+"${roles[@]}"}; do
    if keychain_epoch "$(role_service "$line")" >/dev/null; then
      printf '  %s — キャッシュ済み (触らない)\n' "$line"
      continue
    fi
    # 値は変数に受けるだけで出さない
    if value=$(role_fetch "$line" 0) && [ -n "$value" ] && keychain_put "$(role_service "$line")" "$value"; then
      printf '  %s — 取得してキャッシュした\n' "$line"
    else
      printf '  %s — 取れなかった\n' "$line"
      failed=$((failed + 1))
    fi
  done
  value=''

  if [ "$failed" -gt 0 ]; then
    printf '\n%d 件を取れなかった。1Password にサインインし、設定 > 開発者 の「1Password CLI と連携」を有効にしたうえで、充てる項目にタグ secret-read/<役割> が付いているか確かめてから打ち直す\n' "$failed" >&2
    return 1
  fi
}

# 役割でなければ止める。キャッシュする経路 (--refresh) で使う
require_cacheable_role() {
  is_cacheable "$1" ||
    die "許可リストに無い役割: $1 (キャッシュしてよい役割は secret-cache-allowlist にある)"
}

main() {
  local target

  case "${1:-}" in
  -h | --help)
    usage
    return 0
    ;;
  --check)
    [ "$#" -eq 1 ] || die "--check は引数を取らない"
    cmd_check
    return 0
    ;;
  --warm)
    [ "$#" -eq 1 ] || die "--warm は引数を取らない"
    cmd_warm
    return
    ;;
  --refresh)
    [ "$#" -eq 2 ] || die "--refresh には役割を 1 つだけ渡す"
    target="$2"
    if [ "$(classify_target "$target")" = ref ]; then
      # キャッシュしていない参照なので取り直すも何もない。素通しで読む
      op_read "$target"
      return 0
    fi
    require_cacheable_role "$target"
    # ここで keychain_forget しない。op は時間制限なしなので 1Password が
    # ロック中だと返らず、set -e で死んだ時点で「消えた」だけが残る — 急いで
    # ローテートへ追随するためのコマンドが、いちばん壊す形になっていた (issue #168)。
    # fetch_and_cache → keychain_put が -U で上書きするので消す必要も無い
    fetch_and_cache "$target"
    return 0
    ;;
  --forget)
    [ "$#" -eq 2 ] || die "--forget には役割を 1 つだけ渡す"
    target="$2"
    if [ "$(classify_target "$target")" = ref ]; then
      # 役割に移る前 (issue #289) は op:// の参照そのものを名前にしてキャッシュしていた。
      # その残りを掃除するための口
      keychain_forget "$target"
    else
      keychain_forget "$(role_service "$target")"
    fi
    return 0
    ;;
  --*)
    die "知らないオプション: $1 (--help で使い方)"
    ;;
  '')
    usage >&2
    return 1
    ;;
  esac

  [ "$#" -eq 1 ] || die "役割か参照は 1 つだけ指定する"
  target="$1"

  if [ "$(classify_target "$target")" = ref ]; then
    # 参照を直接渡されたら等級を問わずキャッシュしない。Keychain には残さず 1Password の
    # 生体認証の内側に留める (キャッシュしたいなら役割にして許可リストでレビューを通す)
    op_read "$target"
    return 0
  fi

  # 許可リストに無い役割を素通しにしない。役割は「キャッシュしてよい」と決めたものの
  # 名前なので、載っていないのは綴りの誤りか、レビューを経ていない役割のどちらか
  require_cacheable_role "$target"

  if keychain_get "$(role_service "$target")"; then
    # 寿命を過ぎていれば取り直す。取り直せなければ CACHED_VALUE は据え置きのまま
    refresh_if_stale "$target"
    printf '%s\n' "$CACHED_VALUE"
    return 0
  fi

  fetch_and_cache "$target"
}

main "$@"
