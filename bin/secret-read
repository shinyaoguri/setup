#!/usr/bin/env bash
# 秘密を 1Password から読む。ただし低権限で単一用途のものだけは macOS Keychain へ
# キャッシュし、1Password がロックされていても読めるようにする。
#
# なぜ要るか: 無人で走る自動化 (Claude の hook・scheduled task・バックグラウンドの
# セッション) が、生体認証を前提にした資格情報に依存していて、ロック中は黙って止まる。
# かといって 1Password の自動ロックを切ると、誰も見ていない時間に全 vault が読める状態に
# なってしまう (SSH キーアイテムの秘密鍵も CLI から取り出せる)。そこで秘密を等級で分け、
# 常時開放するのは「キャッシュを許した参照」だけに絞る。
#
# 何を許すかは secret-cache-allowlist に書いてある (載せてよい条件もそこに書いた)。
# 載っていない参照は素通しで op read するだけで、Keychain には一切残さない。この線引きは
# 文書ルールではなくこのスクリプトが強制する。
#
# キャッシュには寿命がある。正本はあくまで 1Password 側なので、TTL を過ぎた項目は次に
# 読まれたときに取り直す。取り直せなければ (ロック中・op が無い) 古い値のまま動き続ける
# ので、可用性は落ちない。これが無いと、ローテートしたトークンをいつまでも返し続け、
# 症状は「その API だけが unauthorized で落ちる」という原因から最も遠い形で出る。
#
# 使い方:
#   secret-read <op-reference>     値を stdout へ (op read の置き換え)
#   secret-read --refresh <ref>    op から取り直して上書きする (ローテート直後に急ぐとき)
#   secret-read --forget <ref>     Keychain のキャッシュを消す
#   secret-read --check            依存と許可リストの健全性だけ見る (値は出さない)
#
# 契約: 値は stdout にしか出さない。エラー文にも値を出さない。
# 呼び出し口は gyazo-capture スキル等の `$(secret-read "$REF")`。
# テストは claude/tests/secret_read_test.py (op / security を PATH で偽物に差し替える)。
# 差し替え口: SECRET_CACHE_ALLOWLIST (許可リストのパス)
#             SECRET_CACHE_TTL (取り直しの間隔・秒。0 で自動更新を止める)
#             SECRET_CACHE_REFRESH_TIMEOUT (取り直しを諦めるまでの秒数)

set -euo pipefail

# symlink 経由で呼ばれても許可リストを見失わないように実体まで辿る
source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  link_dir=$(cd -P "$(dirname "$source_path")" && pwd)
  source_path=$(readlink "$source_path")
  case "$source_path" in /*) ;; *) source_path="$link_dir/$source_path" ;; esac
done
readonly source_path

SCRIPT_DIR=$(cd -P "$(dirname "$source_path")" && pwd)
readonly SCRIPT_DIR

ALLOWLIST="${SECRET_CACHE_ALLOWLIST:-$SCRIPT_DIR/../secret-cache-allowlist}"
readonly ALLOWLIST

# Keychain の account。同じ Mac を複数ユーザーで使う場合に混ざらないようにする
KEYCHAIN_ACCOUNT="${USER:-$(id -un)}"
readonly KEYCHAIN_ACCOUNT

die() {
  printf 'secret-read: %s\n' "$1" >&2
  exit 1
}

# 環境変数の数値。壊れていても止めない — このスクリプトが止まると無人セッションが
# 止まるので、警告して既定へ倒す方が目的に合う
numeric_env() {
  local name="$1" fallback="$2" value
  eval "value=\${$name:-}"
  [ -n "$value" ] || {
    printf '%s' "$fallback"
    return 0
  }
  case "$value" in
  '' | *[!0-9]*)
    printf 'secret-read: %s は 0 以上の整数で指定する (既定 %s を使う): %s\n' \
      "$name" "$fallback" "$value" >&2
    printf '%s' "$fallback"
    ;;
  *) printf '%s' "$value" ;;
  esac
}

# キャッシュの寿命。既定 24 時間 = ローテートに一日で追いつく。0 で自動更新を止める
CACHE_TTL=$(numeric_env SECRET_CACHE_TTL 86400)
readonly CACHE_TTL

# 期限切れの取り直しを諦めるまで。1Password がロックされていると op read は承認を待って
# 返らないので、上限が要る (待たせたらキャッシュを持つ意味が無い)。
# 0 は許さない — 上限を外す設定を用意すると、それを踏んだ無人セッションが止まる
REFRESH_TIMEOUT=$(numeric_env SECRET_CACHE_REFRESH_TIMEOUT 10)
[ "$REFRESH_TIMEOUT" -ge 1 ] || REFRESH_TIMEOUT=1
readonly REFRESH_TIMEOUT

now_epoch() {
  date +%s
}

usage() {
  cat <<'EOF'
secret-read — 1Password の秘密を読む (低権限のものだけ Keychain にキャッシュする)

  secret-read <op-reference>     値を stdout へ (op read の置き換え)
  secret-read --refresh <ref>    op から取り直して上書きする (ローテート直後に急ぐとき)
  secret-read --forget <ref>     Keychain のキャッシュを消す
  secret-read --check            依存と許可リストの健全性だけ見る (値は出さない)

キャッシュしてよい参照は secret-cache-allowlist に列挙する。載っていない参照は
Keychain に残さず、そのつど 1Password から読む。

キャッシュは既定で 24 時間ごとに 1Password から取り直す (SECRET_CACHE_TTL で変えられる。
0 で自動更新を止める)。取り直せないときは古い値のまま動き続けるので、1Password が
ロックされていても止まらない。
EOF
}

validate_ref() {
  case "$1" in
  op://*) ;;
  *) die "op の参照は op:// で始まる必要がある: $1" ;;
  esac
}

# 前後の空白を落とす
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# 許可リストに完全一致で載っているか。行頭 # はコメント、空行は無視。
# 行末コメントは扱わない (vault 名やアイテム名に # が入りうるので、単純な一致に留める)。
is_cacheable() {
  local ref="$1" line
  [ -r "$ALLOWLIST" ] || return 1
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in \#*) continue ;; esac
    line=$(trim "$line")
    [ -n "$line" ] || continue
    [ "$line" = "$ref" ] && return 0
  done <"$ALLOWLIST"
  return 1
}

# 値は base64 にして預ける。改行や特殊文字を含む秘密でも往復が壊れず、security(1) の
# 引数に値が乗らない (プロンプトへ流し込む形になる) ので ps からも見えない。
#
# 預ける文字列は "<最終取得時刻>:<base64値>"。時刻を一緒に持つことで、寿命の判定に
# Keychain の項目以外を読まずに済む。base64 のアルファベット (A-Za-z0-9+/=) に ':' は
# 現れないので、区切りの有無だけで旧形式と見分けられる — 移行の手続きが要らず、
# 時刻を持たない古い項目は「時刻不明」= 次に読まれたときに取り直される。
CACHED_VALUE=""
CACHED_EPOCH=""

# 保存文字列から時刻の部分だけを取り出す。数字でなければ 0 (= 期限切れ扱い) に倒す
epoch_of() {
  local raw="$1" epoch
  case "$raw" in
  *:*) epoch="${raw%%:*}" ;;
  *) epoch=0 ;;
  esac
  case "$epoch" in
  '' | *[!0-9]*) epoch=0 ;;
  esac
  printf '%s' "$epoch"
}

# 成功したら CACHED_VALUE / CACHED_EPOCH に入れる (値を stdout へ出さないのは、
# --check のように「あるかどうか」だけ知りたい呼び出しと同じ経路を使うため)
keychain_get() {
  local raw encoded
  raw=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$1" -w 2>/dev/null) || return 1
  [ -n "$raw" ] || return 1
  case "$raw" in
  *:*) encoded="${raw#*:}" ;;
  *) encoded="$raw" ;;
  esac
  [ -n "$encoded" ] || return 1
  CACHED_VALUE=$(printf '%s' "$encoded" | base64 -d 2>/dev/null) || return 1
  CACHED_EPOCH=$(epoch_of "$raw")
  return 0
}

# --check 用。値には一切触れず、最終取得時刻だけを見る
keychain_epoch() {
  local raw
  raw=$(security find-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$1" -w 2>/dev/null) || return 1
  [ -n "$raw" ] || return 1
  epoch_of "$raw"
}

# 第 3 引数で時刻を指定できる。値は変えずに時刻だけ進めたいとき (取り直しに失敗した
# ときの再試行抑制) に使う
keychain_put() {
  local ref="$1" value="$2" epoch="${3:-}" encoded entry
  [ -n "$epoch" ] || epoch=$(now_epoch)
  encoded=$(printf '%s' "$value" | base64)
  entry="$epoch:$encoded"
  # security(1) は確認のため 2 回読む。-U は既存項目の上書き
  printf '%s\n%s\n' "$entry" "$entry" |
    security add-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$ref" -U \
      -l "secret-read: $ref" \
      -j "secret-read が 1Password からキャッシュした値。正本は 1Password 側。" \
      -w >/dev/null 2>&1
}

# 消えていることが目的なので、もともと無かった場合も成功として扱う
keychain_forget() {
  security delete-generic-password -a "$KEYCHAIN_ACCOUNT" -s "$1" >/dev/null 2>&1 || true
}

op_read() {
  command -v op >/dev/null 2>&1 ||
    die "op (1Password CLI) が見つからず、キャッシュにも無いので値を取れない: $1"
  op read "$1"
}

# 期限切れの取り直し専用。失敗しても呼び出し元は古い値で続行するので、待たないことが
# 何より大事: 1Password がロックされていると op read は承認ダイアログを出したまま返らない。
#
# macOS には timeout(1) も gtimeout も無いので、番兵のサブシェルを立てて時間切れで op を
# 終わらせる。alarm(2) では駄目だった — op は Go 製で SIGALRM を受けても死なず、実測で
# 2 分以上生き残った。確実に終わらせるには SIGTERM、それでも残るなら SIGKILL が要る。
#
# 番兵の出力を /dev/null へ捨てているのは飾りではない。コマンド置換は stdout を持つ子が
# 全ていなくなるまで返らないので、番兵が stdout を握っていると op を殺しても待たされる。
op_read_bounded() {
  local ref="$1" value

  value=$(
    op read "$ref" 2>/dev/null &
    op_pid=$!

    (
      sleep "$REFRESH_TIMEOUT"
      kill -TERM "$op_pid" 2>/dev/null || true
      sleep 1
      kill -KILL "$op_pid" 2>/dev/null || true
    ) >/dev/null 2>&1 &
    sentinel_pid=$!

    if wait "$op_pid"; then
      op_rc=0
    else
      op_rc=$?
    fi
    kill "$sentinel_pid" 2>/dev/null || true
    exit "$op_rc"
  ) || return 1

  [ -n "$value" ] || return 1
  printf '%s' "$value"
}

# キャッシュが寿命を過ぎていたら 1Password から取り直し、CACHED_VALUE を最新にする。
# 取り直せなければ古い値のまま。呼び出し元から見て「失敗」は無い
refresh_if_stale() {
  local ref="$1" fresh age
  [ "$CACHE_TTL" -gt 0 ] || return 0
  # op が無い環境では取り直しようがない。時刻も触らない (状況が変わったら次に試す)
  command -v op >/dev/null 2>&1 || return 0

  age=$(($(now_epoch) - CACHED_EPOCH))
  [ "$age" -ge "$CACHE_TTL" ] || return 0

  if fresh=$(op_read_bounded "$ref") && [ -n "$fresh" ]; then
    CACHED_VALUE="$fresh"
    keychain_put "$ref" "$fresh" ||
      printf 'secret-read: Keychain を更新できなかった (値は取れている): %s\n' "$ref" >&2
    return 0
  fi

  # 取り直せなかった (ロック中・承認待ちでタイムアウト・項目が消えた)。値は据え置きで
  # 時刻だけ進める。こうしないと 1Password が閉じている間じゅう、呼び出しのたびに
  # タイムアウトを待つことになる。ローテート直後にここへ来ると次の TTL まで古いままだが、
  # 急ぐときのための --refresh がある
  keychain_put "$ref" "$CACHED_VALUE" || true
}

# 取得してキャッシュにも入れる。書き込みに失敗しても値は返す (機能低下で済ませる)
fetch_and_cache() {
  local ref="$1" value
  value=$(op_read "$ref")
  if ! keychain_put "$ref" "$value"; then
    printf 'secret-read: Keychain へ保存できなかった (値の取得はできている): %s\n' "$ref" >&2
  fi
  printf '%s\n' "$value"
}

# 秒数を期間として読める形に (「〜前」ではなく「〜ごと」の側)
humanize_ttl() {
  local secs="$1"
  if [ "$secs" -lt 60 ]; then
    printf '%d 秒' "$secs"
  elif [ "$secs" -lt 3600 ]; then
    printf '%d 分' $((secs / 60))
  elif [ "$secs" -lt 86400 ]; then
    printf '%d 時間' $((secs / 3600))
  else
    printf '%d 日' $((secs / 86400))
  fi
}

# 経過秒を人が読める形に。値は出さないという --check の契約に触れない情報だけを扱う
humanize_age() {
  local secs="$1"
  if [ "$secs" -lt 60 ]; then
    printf '1 分以内'
  elif [ "$secs" -lt 3600 ]; then
    printf '%d 分前' $((secs / 60))
  elif [ "$secs" -lt 86400 ]; then
    printf '%d 時間前' $((secs / 3600))
  else
    printf '%d 日前' $((secs / 86400))
  fi
}

cmd_check() {
  local line count=0 status epoch age
  printf '許可リスト: %s\n' "$ALLOWLIST"
  [ -r "$ALLOWLIST" ] || die "許可リストが読めない: $ALLOWLIST"

  if command -v op >/dev/null 2>&1; then
    printf 'op: %s\n' "$(command -v op)"
  else
    printf 'op: 見つからない (キャッシュ済みの参照だけが読める)\n'
  fi
  printf 'security: %s\n' "$(command -v security || printf '見つからない')"
  printf 'Keychain account: %s\n\n' "$KEYCHAIN_ACCOUNT"

  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in \#*) continue ;; esac
    line=$(trim "$line")
    [ -n "$line" ] || continue
    count=$((count + 1))
    case "$line" in
    op://*) ;;
    *)
      printf '  [不正] %s — op:// で始まっていない\n' "$line"
      continue
      ;;
    esac
    # 値は出さない。キャッシュの有無と鮮度だけを見る
    if epoch=$(keychain_epoch "$line"); then
      if [ "$epoch" -eq 0 ]; then
        status='キャッシュ済み (取得時刻が不明 — 次に読むとき取り直す)'
      else
        age=$(($(now_epoch) - epoch))
        status="キャッシュ済み ($(humanize_age "$age")に取得)"
      fi
    else
      status='未キャッシュ (初回の secret-read で入る)'
    fi
    printf '  %s — %s\n' "$line" "$status"
  done <"$ALLOWLIST"

  printf '\nキャッシュを許した参照: %d 件\n' "$count"
  if [ "$CACHE_TTL" -gt 0 ]; then
    printf '取り直しの間隔: %sごと (SECRET_CACHE_TTL)\n' "$(humanize_ttl "$CACHE_TTL")"
  else
    printf '取り直し: 無効 (SECRET_CACHE_TTL=0)\n'
  fi
}

main() {
  local ref

  case "${1:-}" in
  -h | --help)
    usage
    return 0
    ;;
  --check)
    [ "$#" -eq 1 ] || die "--check は引数を取らない"
    cmd_check
    return 0
    ;;
  --refresh)
    [ "$#" -eq 2 ] || die "--refresh には op の参照を 1 つだけ渡す"
    ref="$2"
    validate_ref "$ref"
    if is_cacheable "$ref"; then
      keychain_forget "$ref"
      fetch_and_cache "$ref"
    else
      # キャッシュしていない参照なので取り直すも何もない。素通しで読む
      op_read "$ref"
    fi
    return 0
    ;;
  --forget)
    [ "$#" -eq 2 ] || die "--forget には op の参照を 1 つだけ渡す"
    ref="$2"
    validate_ref "$ref"
    keychain_forget "$ref"
    return 0
    ;;
  --*)
    die "知らないオプション: $1 (--help で使い方)"
    ;;
  '')
    usage >&2
    return 1
    ;;
  esac

  [ "$#" -eq 1 ] || die "参照は 1 つだけ指定する"
  ref="$1"
  validate_ref "$ref"

  if ! is_cacheable "$ref"; then
    # 等級が違う。Keychain には残さず 1Password の生体認証の内側に留める
    op_read "$ref"
    return 0
  fi

  if keychain_get "$ref"; then
    # 寿命を過ぎていれば取り直す。取り直せなければ CACHED_VALUE は据え置きのまま
    refresh_if_stale "$ref"
    printf '%s\n' "$CACHED_VALUE"
    return 0
  fi

  fetch_and_cache "$ref"
}

main "$@"
